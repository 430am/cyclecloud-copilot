#cloud-config
package_update: true
package_upgrade: false
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - jq
  - unzip

runcmd:
  - [bash, -c, "curl -sL https://aka.ms/InstallAzureCLIDeb | bash"]
  - [bash, -c, "mkdir -p /etc/apt/keyrings && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg"]
  - [bash, -c, "echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/ubuntu/24.04/prod noble main' > /etc/apt/sources.list.d/microsoft-prod.list"]
  - [bash, -c, "apt-get update"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get install -y ${cyclecloud_package_name}"]

final_message: "CycleCloud bootstrap completed."
